# =============================================================================
# mera-inference-gateway — environment variables
# Copy this file to .env and fill in the values. Never commit your real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# NEAR AI API key — obtain from https://app.near.ai/
NEAR_AI_API_KEY=your-near-ai-api-key-here

# JWKS endpoint of your auth service (better-auth with jwt() plugin enabled)
AUTH_JWKS_URL=https://auth.example.com/api/auth/jwks

# Expected JWT issuer claim — must match your auth service's configured issuer
# Optional; defaults to 'mera-server-auth' when unset
AUTH_JWT_ISSUER=mera-server-auth

# Redis connection string — used by BullMQ queues
INFERENCE_REDIS_URL=redis://localhost:6379

# HMAC secret for capability tokens
# Must be >=16 bytes of high-entropy random. Generate with: openssl rand -hex 32
INFERENCE_CAPABILITY_SECRET=replace-with-output-of-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Optional — defaults shown
# -----------------------------------------------------------------------------

# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# Request body size limit (express body-parser syntax)
INFERENCE_BODY_LIMIT=50mb

# Rate limiting (per-IP request throttle)
THROTTLE_TTL=60        # rate-limit window in seconds
THROTTLE_LIMIT=30      # max requests per window

# In-memory inference concurrency (InferenceQueueService)
INFERENCE_MAX_CONCURRENCY=8
# Max queued + active requests before backpressure kicks in
INFERENCE_MAX_QUEUE_DEPTH=200

# BullMQ worker concurrency for the llm-inference queue
LLM_INFERENCE_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Job store (dedicated Redis)
# -----------------------------------------------------------------------------

# Dedicated Redis instance for job payloads/results (NOT the BullMQ one).
INFERENCE_JOBS_REDIS_URL=redis://localhost:6379

# Key namespace on the job-store Redis ('inf:' prod, 'inf:stg:' staging)
INFERENCE_JOBS_KEY_PREFIX=inf:

# TTL for job metadata + results — the client re-fetch window (24h)
INFERENCE_JOBS_RESULT_TTL_SECONDS=86400

# TTL for request bodies — only needed while workers process the job (2h)
INFERENCE_JOBS_BODY_TTL_SECONDS=7200

# Submit-time cap on a job's serialized payload bytes (redis store only)
INFERENCE_MAX_JOB_BYTES=5242880

# BullMQ key prefix on the shared Redis ('bull' prod, 'bull-stg' staging)
BULLMQ_PREFIX=bull

# Upstream NEAR AI request timeout in milliseconds. 120s tolerates a cold NEAR
# model on the first request; a lower value risks a 502 while the model warms.
UPSTREAM_TIMEOUT_MS=120000

# Log level (pino). Defaults: 'debug' in development, 'warn' in production
LOG_LEVEL=debug

# Expo push notification access token (optional)
# If unset, push notifications are silently skipped
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Web search (POST /v1/web-search) — OPT-IN, OFF BY DEFAULT
# -----------------------------------------------------------------------------
# This route is the gateway's one plaintext path: Brave has to be queried with
# the user's actual search terms. Nothing but the query text is sent, and the
# query is never logged or stored. See README.md § The one exception.

# Spend gate. The route is live only when this is exactly "true"; otherwise it
# returns {"results": []} and no request leaves the gateway.
BRAVE_SEARCH_ENABLED=false

# Brave Search subscription token, sent as the X-Subscription-Token header.
# Server-only: never returned to a client and never logged. Required only when
# BRAVE_SEARCH_ENABLED=true.
BRAVE_SEARCH_API_KEY=

# Bull Board admin UI credentials
# If BULLBOARD_ADMIN_USERNAME is unset the admin UI returns 503
BULLBOARD_ADMIN_USERNAME=admin
BULLBOARD_ADMIN_PASSWORD=change-me
