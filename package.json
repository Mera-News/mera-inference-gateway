{
  "name": "mera-inference-gateway",
  "version": "0.1.0",
  "description": "Privacy-first E2EE inference gateway \u2014 proxies encrypted chat requests to NEAR AI without ever reading message content",
  "author": "Mera Labs B.V.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mera-news/mera-inference-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/mera-news/mera-inference-gateway/issues"
  },
  "homepage": "https://github.com/mera-news/mera-inference-gateway#readme",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "test:boot": "node scripts/boot-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@bull-board/nestjs": "^9.10.5",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "bullmq": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^18.0.9",
    "expo-server-sdk": "^7.2.0",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "8.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.13.0",
    "ioredis-mock": "8.13.1",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
