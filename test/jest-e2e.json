{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!jose/)"
  ],
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/mocks/expo-server-sdk.js"
  }
}
